DATABASE_URL=postgresql://atlas:atlas@localhost:5434/atlas
PORT=3000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change-me-64-chars
COOKIE_SECRET=change-me-64-chars
# Social sign-in is optional. A provider with no client id and secret simply
# does not appear on the sign-in page, and password auth carries the demo.
# Each redirect URI must be registered verbatim with the provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/linkedin/callback
RESUME_STORAGE_DIR=./uploads
NODE_ENV=development
